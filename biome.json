{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"files": {
		"includes": ["**", "!dist", "!lib"]
	},
	"formatter": {
		"lineWidth": 120
	},
	"linter": {
		"rules": {
			"complexity": {
				"noBannedTypes": "info"
			},
			"correctness": {
				"noUnusedFunctionParameters": "off"
			},
			"style": {
				"noNonNullAssertion": "info",
				"useBlockStatements": "warn"
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	}
}
