{
	"name": "obsidian-query-tools",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/api/index.d.ts",
			"import": "./dist/api/index.js"
		}
	},
	"bin": {
		"obsidian-query": "./dist/cli/index.js",
		"obsidian-query-tools": "./dist/cli/index.js",
		"obsidian-query-tools-mcp": "./dist/mcp/index.js"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc && chmod +x dist/cli/index.js dist/mcp/index.js",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "npm run build && tsc -p tsconfig.test.json && node --test test/api/*.test.ts test/cli/*.test.ts test/host/obsidian/base/*.test.ts test/host/obsidian/files/*.test.ts test/console.test.ts test/mcp/*.test.ts",
		"lint": "biome lint --write .",
		"lint:check": "biome lint .",
		"lint:fix:unsafe": "biome lint --write .",
		"lint:fix": "biome lint --unsafe --write .",
		"fix": "biome check --write .",
		"fix:unsafe": "biome check --unsafe --write .",
		"check": "biome check ."
	},
	"dependencies": {
		"@modelcontextprotocol/server": "2.4.0",
		"commander": "14.0.3",
		"moment": "^2.31.0",
		"yaml": "2.9.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@modelcontextprotocol/client": "2.4.0",
		"@types/node": "24.19.2",
		"typescript": "6.0.3"
	}
}
