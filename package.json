{
	"name": "obsidian-query-tools",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/api/index.d.ts",
			"import": "./dist/api/index.js"
		}
	},
	"bin": {
		"obsidian-query": "./dist/src/cli/index.js",
		"obsidian-query-tools": "./dist/src/cli/index.js",
		"obsidian-query-tools-mcp": "./dist/src/mcp/index.js"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"preinstall": "npm run install:deps && npm run build:deps",
		"install:deps": "npm run install:deps:dataview",
		"install:deps:dataview": "cd lib/dataview && npm run install-build-deps",
		"install:deps:breadcrumbs": "cd lib/breadcrumbs && npm run install-build-deps",
		"build:deps": "npm run build:deps:dataview && npm run build:deps:breadcrumbs",
		"build:deps:dataview": "cd lib/dataview && npm run build",
		"build:deps:breadcrumbs": "cd lib/breadcrumbs && npm run build",
		"build": "npm run build:project",
		"build:full": "npm run install:deps && npm run build:deps && npm install && npm run build",
		"build:project": "tsc && chmod +x dist/src/cli/index.js dist/src/mcp/index.js && cp --update=all src/host/obsidian/package.json dist/src/host/obsidian/package.json",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "npm run build && tsc -p tsconfig.test.json && node --test dist/test/host/obsidian/**/*.test.js dist/test/api/**/*.test.js dist/test/cli/**/*.test.js dist/test/mcp/**/*.test.js",
		"lint": "biome lint --write .",
		"lint:check": "biome lint .",
		"lint:fix:unsafe": "biome lint --write .",
		"lint:fix": "biome lint --unsafe --write .",
		"fix": "biome check --write .",
		"fix:unsafe": "biome check --unsafe --write .",
		"check": "biome check --skip=lint/style/noNonNullAssertion --skip=lint/complexity/noBannedTypes ."
	},
	"dependencies": {
		"@modelcontextprotocol/server": "2.4.0",
		"commander": "14.0.3",
		"fake-indexeddb": "^6.2.8",
		"moment": "^2.31.0",
		"node-localstorage": "^3.0.5",
		"svelte": "^3.59.2",
		"yaml": "2.9.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@modelcontextprotocol/client": "2.4.0",
		"@types/node": "^24.19.2",
		"@types/node-localstorage": "^1.3.3",
		"obsidian": "file:./dist/src/host/obsidian",
		"obsidian-dataview": "file:./dist/lib/dataview",
		"obsidian-breadcrumbs": "file:./dist/lib/breadcrumbs",
		"typescript": "6.0.3"
	},
	"overrides": {
		"obsidian": "file:./dist/src/host/obsidian"
	}
}
