{
	"extends": "./tsconfig.lib.dataview.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "esnext",
		"strict": true,
		"types": ["node"],
		"declaration": true,
		"rootDir": ".",
		"outDir": "dist",
		"skipLibCheck": true,
		"noUnusedLocals": false,
		"rewriteRelativeImportExtensions": true,
		"paths": {
			"obsidian": ["./src/host/obsidian/index.js"],
			"api/*": ["./lib/dataview/dataview/src/api/*"],
			"data-import/*": ["./lib/dataview/dataview/src/data-import/*"],
			"data-index": ["./lib/dataview/dataview/src/data-index/index.js"],
			"data-index/*": ["./lib/dataview/dataview/src/data-index/*"],
			"data-model/*": ["./lib/dataview/dataview/src/data-model/*"],
			"expression/*": ["./lib/dataview/dataview/src/expression/*"],
			"index": ["./lib/dataview/dataview/src/index.js"],
			"query/*": ["./lib/dataview/dataview/src/query/*"],
			"settings": ["./lib/dataview/dataview/src/settings.js"],
			"typings/*": ["./lib/dataview/dataview/src/typings/*"],
			"ui/*": ["./lib/dataview/dataview/src/ui/*"],
			"util/*": ["./lib/dataview/dataview/src/util/*"],
			"util/hash": ["./lib/dataview/dataview/src/util/hash.js"]
		}
	},
	"include": ["src/**/*.ts", "lib/dataview/wrapper.ts", "lib/dataview/dataview/src/typings/workers.d.ts"]
}
